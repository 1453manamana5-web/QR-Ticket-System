{
  "name": "qr-ticket-system-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.migration.json --noEmit",
    "build:migration": "tsc -p tsconfig.migration.json",
    "reset:terminals": "npm run build:migration && node lib-migration/scripts/reset-terminal-data.js",
    "bootstrap:admin": "npm run build:migration && node lib-migration/scripts/bootstrap-admin.js",
    "reset:all-data": "npm run build:migration && node lib-migration/scripts/reset-terminal-data.js"
  },
  "dependencies": {
    "firebase-admin": "^13.5.0",
    "firebase-functions": "^6.4.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
