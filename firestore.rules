rules_version = '2';

// Reapplication uses the existing terminal ID and authenticated owner UID.
// terminalApplications: exact bounded registration fields; pending only.
// terminals: reception-only, already revoked; only name/type/status/times change.
// Owner/installation mappings and all approval/role fields remain immutable.
// Heartbeat additions (optional): receptionMode entry/exit/stopped; receptionEventId
// string 1..160; receptionReportedAt server timestamp. They confer no permissions.
// New registration IDs are 1..160 characters; requestedAt/updatedAt are
// nonempty strings up to 40 characters, including during reapplication.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // A browser UID is not a role. Management writes require a server-issued
    // installation grant and a currently approved management-capable terminal.
    function managementTerminalId() {
      return get(/databases/$(database)/documents/terminalInstallations/$(request.auth.uid)).data.terminalId;
    }

    function approvedManagementTerminal() {
      let installation = get(/databases/$(database)/documents/terminalInstallations/$(request.auth.uid)).data;
      let terminal = get(/databases/$(database)/documents/terminals/$(installation.terminalId)).data;
      let owner = get(/databases/$(database)/documents/terminalOwners/$(installation.terminalId)).data;
      return signedIn() && installation.authUid == request.auth.uid && installation.approved == true
        && owner.enabled == true && owner.ownerUid == request.auth.uid
        && terminal.approved == true && terminal.role in ["management","both"] && terminal.managementApproved == true;
    }

    function approvedReceptionTerminal() {
      let installation = get(/databases/$(database)/documents/terminalInstallations/$(request.auth.uid)).data;
      let terminal = get(/databases/$(database)/documents/terminals/$(installation.terminalId)).data;
      let owner = get(/databases/$(database)/documents/terminalOwners/$(installation.terminalId)).data;
      return signedIn() && installation.authUid == request.auth.uid && installation.approved == true
        && owner.enabled == true && terminal.approved == true
        && ((terminal.role in ["management","both"] && terminal.managementApproved == true && owner.ownerUid == request.auth.uid)
          || (terminal.role in ["reception","both"] && (!terminal.keys().hasAny(["receptionApproved"]) || terminal.receptionApproved == true)));
    }

    // Event approval is independent of permanent terminal/management registration.
    function approvedReceptionForEvent(eventId) {
      return approvedReceptionTerminal()
        && exists(/databases/$(database)/documents/events/$(eventId)/receptionApprovals/$(receptionTerminalId()))
        && get(/databases/$(database)/documents/events/$(eventId)/receptionApprovals/$(receptionTerminalId())).data.status == "approved"
        && get(/databases/$(database)/documents/events/$(eventId)/receptionApprovals/$(receptionTerminalId())).data.requestedByUid == request.auth.uid;
    }

    function counterAdministrator() {
      return approvedManagementTerminal()
        && get(terminalPath(managementTerminalId())).data.get("admin", false) == true;
    }

    function counterOperator() {
      return approvedManagementTerminal()
        && (get(terminalPath(managementTerminalId())).data.get("admin", false) == true
          || get(terminalPath(managementTerminalId())).data.get("subAdmin", false) == true);
    }

    function counterDevicePath(eventId) {
      return /databases/$(database)/documents/events/$(eventId)/counterDevices/$(request.auth.uid);
    }

    function counterAssignment(eventId, role) {
      return /databases/$(database)/documents/events/$(eventId)/counterAssignments/$(role);
    }

    function ownCounterAssignment(eventId) {
      let device = get(counterDevicePath(eventId)).data;
      return get(counterAssignment(eventId, device.role)).data.uid == request.auth.uid;
    }

    function approvedCounterDevice(eventId) {
      return signedIn() && exists(counterDevicePath(eventId))
        && get(counterDevicePath(eventId)).data.status == "approved"
        && (!exists(counterDayPath(eventId)) || ownCounterAssignment(eventId));
    }

    function counterMode(mode) {
      return mode in ["test", "live"];
    }

    function counterTime(value) {
      return value is number && value >= 0 && value <= 8640000000000000;
    }

    function validCounterConfig(data) {
      return data.keys().hasAll(["opened", "closed", "paused", "verified", "updatedAt", "updatedByUid"])
        && data.keys().hasOnly(["opened", "closed", "paused", "verified", "updatedAt", "updatedByUid", "version"])
        && (!data.keys().hasAny(["version"]) || (data.version is int && data.version >= 0))
        && (data.opened == null || (data.opened is int && counterTime(data.opened)))
        && (data.closed == null || (data.closed is int && counterTime(data.closed) && data.opened != null && data.closed >= data.opened))
        && data.paused is bool && data.verified is bool
        && (!data.verified || (data.opened != null && data.closed != null))
        && data.updatedAt == request.time && data.updatedByUid == request.auth.uid;
    }

    function validCounterDeviceName(name) {
      return name is string && name.size() > 0 && name.size() <= 80;
    }

    function validCounterDeviceId(id) {
      return id is string && id.matches("^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$");
    }

    function counterOperationId(id) {
      return id is string && id.matches("^(ledger|edit):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$");
    }

    function counterRevisionSnapshot(data) {
      return data is map
        && data.keys().hasAll(["at", "direction", "person", "invalid", "clockWarning", "clockUncertainty"])
        && data.keys().hasOnly(["at", "direction", "person", "invalid", "clockWarning", "clockUncertainty"])
        && counterTime(data.at) && data.direction in ["in", "out"]
        && data.person in ["visitor", "staff"] && data.invalid is bool
        && (data.clockWarning == null || (data.clockWarning is string && data.clockWarning.size() <= 80))
        && (data.clockUncertainty == null || counterTime(data.clockUncertainty));
    }

    function validCounterPassage(data) {
      return data.keys().hasAll(["at", "direction", "person", "source", "invalid"])
        && data.keys().hasOnly(["id", "kind", "eventId", "mode", "device", "actorUid", "rawAt", "at", "createdAt",
          "station", "direction", "person", "source", "invalid", "clockWarning", "clockUncertainty", "reason", "sequence", "passageId", "configVersion"])
        && data.id.matches("^ledger:.*$")
        && counterTime(data.at) && data.direction in ["in", "out"]
        && data.person in ["visitor", "staff"] && data.source in ["auto", "manual"] && data.invalid == false
        && (!data.keys().hasAny(["configVersion"]) || (data.configVersion is int && data.configVersion >= 0))
        && (!data.keys().hasAny(["sequence"]) || (data.sequence is int && data.sequence > 0))
        && (!data.keys().hasAny(["passageId"]) || validCounterDeviceId(data.passageId))
        && (!data.keys().hasAny(["clockWarning"]) || (data.clockWarning is string && data.clockWarning.size() <= 80))
        && (!data.keys().hasAny(["clockUncertainty"]) || data.clockUncertainty == null || counterTime(data.clockUncertainty))
        && (!data.keys().hasAny(["reason"]) || (data.reason is string && data.reason.size() <= 180));
    }

    function validCounterRevision(data) {
      return data.keys().hasAll(["target", "parent", "before", "after", "reason", "resolves"])
        && data.keys().hasOnly(["id", "kind", "eventId", "mode", "device", "actorUid", "rawAt", "at", "createdAt",
          "station", "source", "target", "parent", "before", "after", "reason", "resolves"])
        && data.id.matches("^edit:.*$")
        && counterOperationId(data.target) && counterOperationId(data.parent) && data.target.matches("^ledger:.*$")
        && data.id != data.parent && data.reason is string && data.reason.size() > 0 && data.reason.size() <= 180
        && data.resolves is list && data.resolves.size() <= 100
        && (!data.keys().hasAny(["at"]) || counterTime(data.at))
        && (!data.keys().hasAny(["source"]) || data.source == "manual")
        && counterRevisionSnapshot(data.before) && counterRevisionSnapshot(data.after);
    }

    function receptionTerminalId() {
      return get(/databases/$(database)/documents/terminalInstallations/$(request.auth.uid)).data.terminalId;
    }

    function activeReceptionEvent(eventId) {
      return eventId is string
        && exists(/databases/$(database)/documents/events/$(eventId))
        && get(/databases/$(database)/documents/events/$(eventId)).data.receptionTarget == true
        && (
          !get(/databases/$(database)/documents/events/$(eventId)).data.keys().hasAny(["eventStatus"])
          || get(/databases/$(database)/documents/events/$(eventId)).data.eventStatus != "finished"
        );
    }

    function validReceptionTimestamp(value) {
      return value is string && value.size() >= 20 && value.size() <= 40
        && value.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z$");
    }

    function validReceptionTicketUpdate(eventId, ticketId) {
      let recordId = request.resource.data.lastReceptionRecordId;
      let beforeStatus = resource.data.currentStatus;
      let afterStatus = request.resource.data.currentStatus;
      return approvedReceptionForEvent(eventId)
        && activeReceptionEvent(eventId)
        && request.resource.data.eventId == eventId
        && request.resource.data.ticketId == ticketId
        && resource.data.ticketId == ticketId
        && resource.data.eventId == eventId
        && resource.data.valid == true
        && request.resource.data.valid == resource.data.valid
        && recordId is string && recordId.size() > 0 && recordId.size() <= 160
        && !exists(/databases/$(database)/documents/events/$(eventId)/receptionRecords/$(recordId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "currentStatus", "updatedAt", "lastReceptionRecordId"
        ])
        && validReceptionTimestamp(request.resource.data.updatedAt)
        && existsAfter(/databases/$(database)/documents/events/$(eventId)/receptionRecords/$(recordId))
        && getAfter(/databases/$(database)/documents/events/$(eventId)/receptionRecords/$(recordId)).data.recordId == recordId
        && getAfter(/databases/$(database)/documents/events/$(eventId)/receptionRecords/$(recordId)).data.eventId == eventId
        && getAfter(/databases/$(database)/documents/events/$(eventId)/receptionRecords/$(recordId)).data.ticketId == ticketId
        && getAfter(/databases/$(database)/documents/events/$(eventId)/receptionRecords/$(recordId)).data.terminalId == receptionTerminalId()
        && getAfter(/databases/$(database)/documents/events/$(eventId)/receptionRecords/$(recordId)).data.timestamp == request.resource.data.updatedAt
        && (
          (beforeStatus == "unused" && afterStatus == "inside"
            && getAfter(/databases/$(database)/documents/events/$(eventId)/receptionRecords/$(recordId)).data.type == "entry")
          || (beforeStatus == "exited" && afterStatus == "inside"
            && getAfter(/databases/$(database)/documents/events/$(eventId)/receptionRecords/$(recordId)).data.type == "reentry")
          || (beforeStatus == "inside" && afterStatus == "exited"
            && getAfter(/databases/$(database)/documents/events/$(eventId)/receptionRecords/$(recordId)).data.type == "exit")
        );
    }

    function validReceptionRecordCreate(eventId, recordId) {
      let data = request.resource.data;
      let ticketPath = /databases/$(database)/documents/events/$(eventId)/tickets/$(data.ticketId);
      return approvedReceptionForEvent(eventId)
        && activeReceptionEvent(eventId)
        && data.keys().hasOnly(["recordId", "eventId", "ticketId", "terminalId", "type", "timestamp"])
        && data.recordId == recordId && recordId.size() > 0 && recordId.size() <= 160
        && data.eventId == eventId
        && data.ticketId is string
        && data.ticketId.size() > 0
        && data.ticketId.size() <= 160
        && data.terminalId == receptionTerminalId()
        && data.type in ["entry", "exit", "reentry"]
        && validReceptionTimestamp(data.timestamp)
        && exists(ticketPath)
        && get(ticketPath).data.valid == true
        && existsAfter(ticketPath)
        && getAfter(ticketPath).data.lastReceptionRecordId == recordId
        && getAfter(ticketPath).data.updatedAt == data.timestamp
        && (
          (data.type == "entry" && get(ticketPath).data.currentStatus == "unused"
            && getAfter(ticketPath).data.currentStatus == "inside")
          || (data.type == "reentry" && get(ticketPath).data.currentStatus == "exited"
            && getAfter(ticketPath).data.currentStatus == "inside")
          || (data.type == "exit" && get(ticketPath).data.currentStatus == "inside"
            && getAfter(ticketPath).data.currentStatus == "exited")
        );
    }

    function approvedOwnInstallationForTerminal(terminalId) {
      return signedIn()
        && exists(/databases/$(database)/documents/terminalInstallations/$(request.auth.uid))
        && get(/databases/$(database)/documents/terminalInstallations/$(request.auth.uid)).data.authUid == request.auth.uid
        && get(/databases/$(database)/documents/terminalInstallations/$(request.auth.uid)).data.approved == true
        && get(/databases/$(database)/documents/terminalInstallations/$(request.auth.uid)).data.terminalId == terminalId
        && exists(/databases/$(database)/documents/terminalOwners/$(terminalId))
        && get(/databases/$(database)/documents/terminalOwners/$(terminalId)).data.enabled == true
        && exists(/databases/$(database)/documents/terminals/$(terminalId))
        && get(/databases/$(database)/documents/terminals/$(terminalId)).data.approved == true;
    }

    function validTerminalHeartbeatUpdate(terminalId) {
      let current = resource.data;
      let next = request.resource.data;
      let ownerPath = /databases/$(database)/documents/terminalOwners/$(terminalId);
      let installationPath = /databases/$(database)/documents/terminalInstallations/$(request.auth.uid);
      let ownerMatches = exists(ownerPath)
        && get(ownerPath).data.enabled == true
        && get(ownerPath).data.ownerUid == request.auth.uid;
      let installationMatches = exists(installationPath)
        && get(installationPath).data.authUid == request.auth.uid
        && get(installationPath).data.terminalId == terminalId
        && get(installationPath).data.approved == true;
      let managementActive = current.approved == true
        && current.managementApproved == true
        && (current.role == "management" || current.role == "both");
      let receptionActive = current.approved == true
        && (current.receptionApproved == true
          || (!current.keys().hasAny(["receptionApproved"]) && current.approved == true))
        && (current.role == "reception" || current.role == "both");
      return signedIn()
        && ((ownerMatches && (managementActive || receptionActive))
          || (installationMatches && receptionActive))
        && next.diff(current).affectedKeys().hasOnly([
          "status", "lastSeen", "updatedAt", "syncPendingCount", "networkMbps", "mode", "name", "receptionMode", "receptionEventId", "receptionReportedAt"
        ])
        && next.status == "online"
        && next.lastSeen is string && next.lastSeen.size() > 0 && next.lastSeen.size() <= 40
        && next.updatedAt is string && next.updatedAt.size() > 0 && next.updatedAt.size() <= 40
        && next.syncPendingCount is int
        && next.syncPendingCount >= 0
        && next.syncPendingCount <= 100000
        && (!next.keys().hasAny(["receptionMode"]) || next.receptionMode in ["entry", "exit", "stopped"])
        && (!next.keys().hasAny(["receptionReportedAt"]) || next.receptionReportedAt is timestamp)
        && (!next.diff(current).affectedKeys().hasAny(["receptionMode", "receptionEventId", "receptionReportedAt"]) || next.receptionReportedAt == request.time)
        && (!next.keys().hasAny(["receptionEventId"]) || (next.receptionEventId is string && next.receptionEventId.size() > 0 && next.receptionEventId.size() <= 160))
        && (!next.keys().hasAny(["networkMbps"])
          || (next.networkMbps is number && next.networkMbps >= 0 && next.networkMbps <= 10000))
        && (!next.diff(current).affectedKeys().hasAny(["mode"])
          || (ownerMatches && managementActive
            && next.mode in ["入口受付", "出口受付", "停止"]))
        && (!next.diff(current).affectedKeys().hasAny(["name"])
          || (ownerMatches && managementActive
            && next.name is string && next.name.size() > 0 && next.name.size() <= 80));
    }

    function validManagedModeUpdate(terminalId) {
      let current = resource.data;
      let next = request.resource.data;
      return terminalId != managementTerminalId()
        && current.approved == true
        && next.diff(current).affectedKeys().hasOnly(["desiredMode", "desiredModeUpdatedAt"])
        && next.desiredMode in ["入口受付", "出口受付", "停止"]
        && next.desiredModeUpdatedAt is string
        && next.desiredModeUpdatedAt.size() > 0
        && next.desiredModeUpdatedAt.size() <= 40;
    }

    function applicationPath(terminalId) {
      return /databases/$(database)/documents/terminalApplications/$(terminalId);
    }

    function terminalPath(terminalId) {
      return /databases/$(database)/documents/terminals/$(terminalId);
    }

    function ownerPath(terminalId) {
      return /databases/$(database)/documents/terminalOwners/$(terminalId);
    }

    function installationPath(uid) {
      return /databases/$(database)/documents/terminalInstallations/$(uid);
    }

    function boundedRegistrationMetadata(data, terminalId) {
      return terminalId.size() > 0 && terminalId.size() <= 160
        && data.requestedAt is string && data.requestedAt.size() > 0 && data.requestedAt.size() <= 40
        && data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 40;
    }

    function validTerminalRegistrationCreate(terminalId) {
      let data = request.resource.data;
      let app = getAfter(applicationPath(terminalId)).data;
      return signedIn() && boundedRegistrationMetadata(data, terminalId)
        && !exists(ownerPath(terminalId))
        && !exists(terminalPath(terminalId))
        && existsAfter(applicationPath(terminalId))
        && app.terminalId == terminalId
        && app.requestedByUid == request.auth.uid
        && app.status == "pending"
        && app.requestedRole == data.requestedRole
        && data.keys().hasOnly([
          "terminalId", "requestedByUid", "requestedRole", "name", "type",
          "role", "approved", "managementApproved", "receptionApproved",
          "admin", "subAdmin", "status", "mode", "desiredMode",
          "requestedAt", "updatedAt", "syncPendingCount"
        ])
        && data.terminalId == terminalId
        && data.requestedByUid == request.auth.uid
        && data.role == data.requestedRole
        && data.requestedRole in ["management", "reception", "both"]
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.type in ["Web / iPad", "Web / PC"]
        && data.approved == false
        && data.managementApproved == false
        && data.receptionApproved == false
        && data.admin == false && data.subAdmin == false
        && data.status == "pending"
        && data.mode == "停止" && data.desiredMode == "停止"
        && data.requestedAt is string && data.updatedAt is string
        && data.syncPendingCount == 0;
    }

    function validReceptionReapplicationData(data, terminalId) {
      return data.keys().hasAll(["terminalId", "requestedByUid", "requestedRole", "name", "type", "status", "requestedAt", "updatedAt"])
        && data.keys().hasOnly(["terminalId", "requestedByUid", "requestedRole", "name", "type", "status", "requestedAt", "updatedAt"])
        && data.terminalId == terminalId
        && data.terminalId is string && data.terminalId.size() > 0 && data.terminalId.size() <= 160
        && data.requestedByUid == request.auth.uid
        && data.requestedRole == "reception"
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.type in ["Web / iPad", "Web / PC"]
        && data.status == "pending"
        && data.requestedAt is string && data.requestedAt.size() > 0 && data.requestedAt.size() <= 40
        && data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 40;
    }

    function ownsRevokedReceptionTerminal(terminalId) {
      let terminal = get(terminalPath(terminalId)).data;
      let owner = get(ownerPath(terminalId)).data;
      let installation = get(installationPath(request.auth.uid)).data;
      return signedIn()
        && owner.enabled == true && owner.ownerUid == request.auth.uid
        && installation.authUid == request.auth.uid && installation.approved == true
        && installation.terminalId == terminalId
        && terminal.terminalId == terminalId && terminal.requestedByUid == request.auth.uid
        && terminal.role == "reception" && terminal.requestedRole == "reception"
        && terminal.approved == false && terminal.receptionApproved == false
        && terminal.managementApproved == false && terminal.admin == false && terminal.subAdmin == false;
    }

    function validOwnReceptionReapplication(terminalId) {
      let application = getAfter(applicationPath(terminalId)).data;
      let terminal = get(terminalPath(terminalId)).data;
      let next = getAfter(terminalPath(terminalId)).data;
      return ownsRevokedReceptionTerminal(terminalId)
        && validReceptionReapplicationData(application, terminalId)
        && next.diff(terminal).affectedKeys().hasOnly(["name", "type", "status", "requestedAt", "updatedAt"])
        && next.name == application.name && next.type == application.type
        && next.status == "pending" && next.requestedAt == application.requestedAt
        && next.updatedAt == application.updatedAt;
    }

    function validOwnReceptionReapplicationCancellation(terminalId) {
      let app = get(applicationPath(terminalId)).data;
      return ownsRevokedReceptionTerminal(terminalId)
        && app.requestedByUid == request.auth.uid && app.status == "pending"
        && !existsAfter(applicationPath(terminalId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
        && request.resource.data.status == "offline"
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() > 0 && request.resource.data.updatedAt.size() <= 40;
    }

    function validTerminalApprovalUpdate(terminalId) {
      let current = resource.data;
      let next = request.resource.data;
      let appPath = applicationPath(terminalId);
      let ownManager = get(terminalPath(managementTerminalId())).data;
      let app = get(appPath).data;
      let appAfter = getAfter(appPath).data;
      let owner = getAfter(ownerPath(terminalId)).data;
      let installation = getAfter(installationPath(app.requestedByUid)).data;
      let role = current.requestedRole;
      return terminalId != managementTerminalId()
        && current.approved == false
        && current.requestedByUid == app.requestedByUid
        && current.requestedRole == app.requestedRole
        && app.terminalId == terminalId
        && app.status == "pending"
        && next.diff(current).affectedKeys().hasOnly([
          "approved", "status", "managementApproved", "receptionApproved",
          "approvalUpdatedAt", "approvalUpdatedByUid", "updatedAt"
        ])
        && (ownManager.admin == true || (ownManager.subAdmin == true && role == "reception"))
        && role in ["management", "reception", "both"]
        && next.approved == true && next.status == "offline"
        && next.managementApproved == (role in ["management", "both"])
        && next.receptionApproved == (role in ["reception", "both"])
        && next.approvalUpdatedAt is string
        && next.approvalUpdatedByUid == request.auth.uid
        && next.updatedAt is string
        && owner.terminalId == terminalId
        && owner.ownerUid == app.requestedByUid
        && owner.enabled == true
        && installation.terminalId == terminalId
        && installation.authUid == app.requestedByUid
        && installation.approved == true
        && appAfter.status == "approved"
        && appAfter.decidedByUid == request.auth.uid;
    }

    function validTerminalApprovalGrant(terminalId) {
      let target = get(terminalPath(terminalId)).data;
      let app = getAfter(applicationPath(terminalId)).data;
      let owner = getAfter(ownerPath(terminalId)).data;
      let installation = getAfter(installationPath(app.requestedByUid)).data;
      let manager = get(terminalPath(managementTerminalId())).data;
      return app.terminalId == terminalId
        && get(applicationPath(terminalId)).data.status == "pending"
        && app.status == "approved"
        && app.decidedByUid == request.auth.uid
        && target.requestedByUid == app.requestedByUid
        && target.requestedRole == app.requestedRole
        && target.approved == false
        && (!exists(ownerPath(terminalId))
          || (get(ownerPath(terminalId)).data.enabled == true
            && get(ownerPath(terminalId)).data.ownerUid == app.requestedByUid))
        && (!exists(installationPath(app.requestedByUid))
          || (get(installationPath(app.requestedByUid)).data.authUid == app.requestedByUid
            && get(installationPath(app.requestedByUid)).data.terminalId == terminalId
            && get(installationPath(app.requestedByUid)).data.approved == true))
        && owner.terminalId == terminalId
        && owner.ownerUid == app.requestedByUid
        && owner.enabled == true
        && installation.terminalId == terminalId
        && installation.authUid == app.requestedByUid
        && installation.approved == true
        && (manager.admin == true || (manager.subAdmin == true && target.requestedRole == "reception"));
    }

    function validSubAdminUpdate(terminalId) {
      let current = resource.data;
      let next = request.resource.data;
      let manager = get(terminalPath(managementTerminalId())).data;
      let owner = get(ownerPath(terminalId)).data;
      let install = get(installationPath(owner.ownerUid)).data;
      return manager.admin == true
        && terminalId != managementTerminalId()
        && current.admin != true
        && current.approved == true
        && current.managementApproved == true
        && current.role in ["management", "both"]
        && owner.enabled == true
        && owner.ownerUid is string
        && install.authUid == owner.ownerUid
        && install.terminalId == terminalId
        && install.approved == true
        && next.diff(current).affectedKeys().hasOnly(["subAdmin", "subAdminUpdatedAt", "subAdminUpdatedByUid"])
        && next.subAdmin is bool
        && next.subAdminUpdatedAt is string
        && next.subAdminUpdatedByUid == request.auth.uid;
    }

    function validManagedReceptionRevoke(terminalId) {
      let current = resource.data;
      let next = request.resource.data;
      let manager = get(terminalPath(managementTerminalId())).data;
      return terminalId != managementTerminalId()
        && (manager.admin == true || manager.subAdmin == true)
        && current.admin != true && current.subAdmin != true
        && current.role in ["management", "reception", "both"]
        && next.diff(current).affectedKeys().hasOnly([
          "receptionApproved", "receptionApprovalVersion", "approved",
          "mode", "desiredMode", "desiredModeUpdatedAt", "updatedAt",
          "approvalUpdatedAt", "approvalUpdatedByUid", "role"
        ])
        && next.receptionApproved == false
        && next.receptionApprovalVersion is int
        && next.receptionApprovalVersion == (current.get("receptionApprovalVersion", 0) is int ? current.get("receptionApprovalVersion", 0) + 1 : 1)
        && next.approved == (current.managementApproved == true)
        && next.mode == "停止" && next.desiredMode == "停止"
        && next.desiredModeUpdatedAt is string && next.updatedAt is string
        && next.approvalUpdatedAt is string
        && next.approvalUpdatedByUid == request.auth.uid
        && next.role == (current.role == "both" ? "management" : current.role);
    }

    function validOwnReceptionRelease(terminalId) {
      let current = resource.data;
      let next = request.resource.data;
      let owner = get(ownerPath(terminalId)).data;
      let install = get(installationPath(request.auth.uid)).data;
      return signedIn()
        && owner.ownerUid == request.auth.uid && owner.enabled == true
        && install.authUid == request.auth.uid && install.terminalId == terminalId
        && install.approved == true
        && next.diff(current).affectedKeys().hasOnly([
          "receptionApproved", "receptionApprovalVersion", "approved",
          "mode", "desiredMode", "desiredModeUpdatedAt", "updatedAt",
          "approvalUpdatedAt", "approvalUpdatedByUid", "role"
        ])
        && next.receptionApproved == false
        && next.receptionApprovalVersion is int
        && next.receptionApprovalVersion == (current.get("receptionApprovalVersion", 0) is int ? current.get("receptionApprovalVersion", 0) + 1 : 1)
        && next.approved == (current.managementApproved == true)
        && next.mode == "停止" && next.desiredMode == "停止"
        && next.desiredModeUpdatedAt is string && next.updatedAt is string
        && next.approvalUpdatedAt is string
        && next.approvalUpdatedByUid == request.auth.uid
        && next.role == (current.role == "both" && current.managementApproved == true ? "management" : current.role);
    }

    function validOwnPendingTerminalCancellation(terminalId) {
      return signedIn()
        && resource.data.approved == false
        && resource.data.requestedByUid == request.auth.uid
        && !exists(ownerPath(terminalId))
        && get(applicationPath(terminalId)).data.requestedByUid == request.auth.uid
        && get(applicationPath(terminalId)).data.status == "pending"
        && !existsAfter(applicationPath(terminalId));
    }

    function validTerminalDeletion(terminalId) {
      let manager = get(terminalPath(managementTerminalId())).data;
      let target = resource.data;
      let ownerAfter = getAfter(ownerPath(terminalId)).data;
      return terminalId != managementTerminalId()
        && (manager.admin == true || manager.subAdmin == true)
        && target.admin != true && target.subAdmin != true
        && (manager.admin == true || !(target.role in ["management", "both"]))
        && ownerAfter.terminalId == terminalId
        && ownerAfter.enabled == false
        && ownerAfter.deletedByUid == request.auth.uid
        && !existsAfter(applicationPath(terminalId));
    }

    function validOwnerTombstoneWrite(terminalId) {
      let targetPath = terminalPath(terminalId);
      let target = get(targetPath).data;
      let next = request.resource.data;
      let manager = get(terminalPath(managementTerminalId())).data;
      return exists(targetPath)
        && terminalId != managementTerminalId()
        && (manager.admin == true || manager.subAdmin == true)
        && target.admin != true && target.subAdmin != true
        && (manager.admin == true || !(target.role in ["management", "both"]))
        && !existsAfter(targetPath)
        && !existsAfter(applicationPath(terminalId))
        && next.terminalId == terminalId
        && next.enabled == false
        && next.deletedByUid == request.auth.uid
        && next.updatedAt is string
        && (!next.keys().hasAny(["ownerUid"]) || next.ownerUid == target.requestedByUid);
    }

    // Client apps must never manage trusted ownership or server-issued handoff state.
    match /terminalOwners/{terminalId} {
      allow get: if approvedManagementTerminal()
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || (signedIn()
          && exists(installationPath(request.auth.uid))
          && get(installationPath(request.auth.uid)).data.authUid == request.auth.uid
          && get(installationPath(request.auth.uid)).data.approved == true
          && get(installationPath(request.auth.uid)).data.terminalId == terminalId);
      allow list: if approvedManagementTerminal();
      allow create, update: if approvedManagementTerminal()
        && (validTerminalApprovalGrant(terminalId) || validOwnerTombstoneWrite(terminalId));
      allow delete: if false;
    }

    match /terminalInstallations/{uid} {
      // Own grant is readable by the installation; approved managers may verify a target grant.
      allow get: if (signedIn() && request.auth.uid == uid) || approvedManagementTerminal();
      allow list: if approvedManagementTerminal();
      allow create, update: if (approvedManagementTerminal()
          && validTerminalApprovalGrant(request.resource.data.terminalId)
          && request.resource.data.authUid == uid)
        || (signedIn() && request.auth.uid == uid
          && resource.data.authUid == uid
          && resource.data.approved == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["approved", "releasedAt"])
          && request.resource.data.approved == false
          && request.resource.data.releasedAt is string);
      allow delete: if false;
    }

    match /terminalHandoffRequests/{requestId} {
      allow read, write: if false;
    }

    match /terminalHandoffRateLimits/{uid} {
      allow read, write: if false;
    }

    // A signed-in browser may submit/cancel only its own pending application.
    // Approval and trusted ownership grants remain impossible from client rules.
    match /terminalApplications/{terminalId} {
      allow get: if approvedManagementTerminal()
        || (signedIn() && resource.data.requestedByUid == request.auth.uid);
      allow list: if approvedManagementTerminal()
        || (signedIn() && request.query.limit <= 5 && resource.data.requestedByUid == request.auth.uid);
      allow create: if (request.resource.data.status == "pending" && validOwnReceptionReapplication(terminalId)) || (signedIn()
        && !exists(ownerPath(terminalId))
        && !exists(terminalPath(terminalId))
        && request.resource.data.keys().hasOnly([
          "terminalId", "requestedByUid", "requestedRole", "name", "type",
          "status", "requestedAt", "updatedAt"
        ])
        && request.resource.data.terminalId == terminalId
        && boundedRegistrationMetadata(request.resource.data, terminalId)
        && request.resource.data.requestedByUid == request.auth.uid
        && request.resource.data.requestedRole in ["management", "reception", "both"]
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.type in ["Web / iPad", "Web / PC"]
        && request.resource.data.status == "pending"
        && request.resource.data.requestedAt is string
        && request.resource.data.updatedAt is string);
      allow delete: if (signedIn()
          && resource.data.requestedByUid == request.auth.uid
          && resource.data.status == "pending")
        || (approvedManagementTerminal() && exists(terminalPath(terminalId))
          && !existsAfter(terminalPath(terminalId)));
      allow update: if (request.resource.data.status == "pending" && validOwnReceptionReapplication(terminalId)) || (approvedManagementTerminal()
        && resource.data.status == "pending"
        && request.resource.data.status == "approved"
        && request.resource.data.terminalId == terminalId
        && request.resource.data.requestedByUid == resource.data.requestedByUid
        && request.resource.data.requestedRole == resource.data.requestedRole
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "decidedAt", "decidedByUid", "updatedAt"
        ])
        && request.resource.data.decidedAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.decidedByUid == request.auth.uid
        && getAfter(terminalPath(terminalId)).data.approved == true
        && getAfter(ownerPath(terminalId)).data.enabled == true
        && getAfter(installationPath(resource.data.requestedByUid)).data.approved == true);
    }

    // Reception downloads the selected event and its tickets for offline use.
    // Other event data and all management writes remain management-only.
    match /counterClocks/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(["at", "eventId"])
        && request.resource.data.keys().hasOnly(["at", "eventId"])
        && request.resource.data.eventId is string && request.resource.data.eventId.size() > 0
        && request.resource.data.eventId.size() <= 160
        && (approvedCounterDevice(request.resource.data.eventId) || counterOperator())
        && request.resource.data.at == request.time;
    }

    function counterDayPath(id) {
      return /databases/$(database)/documents/counterDays/$(id);
    }

    function counterScopeExists(id) {
      return exists(counterDayPath(id)) || exists(/databases/$(database)/documents/events/$(id));
    }

    function counterUuid(id) {
      return id is string && id.matches("^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$");
    }

    function validCounterAudit(data) {
      return data.updatedAt == request.time && data.updatedByUid == request.auth.uid;
    }

    function counterStage(value) {
      return value in ["prepare", "trial", "open", "restricted", "closing", "finished"];
    }

    function counterWall(value) {
      return value == null || (value is int && counterTime(value)
        && value <= (request.time + duration.value(2, "m")).toMillis());
    }

    match /counterEvents/{id} {
      allow get, list: if counterOperator();
      allow create, update: if counterOperator() && counterUuid(id)
        && request.resource.data.keys().hasOnly(["name", "venue", "updatedAt", "updatedByUid"])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.venue is string && request.resource.data.venue.size() > 0 && request.resource.data.venue.size() <= 100
        && validCounterAudit(request.resource.data);
    }

    match /counterDays/{id} {
      function validDay(data) {
        return data.keys().hasOnly(["eventId","date","start","end","stage","opened","trialOpened",
          "closing","ended","emptyConfirmed","finalized","version","operation","updatedAt","updatedByUid"])
          && counterUuid(data.eventId) && data.date is string && data.date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
          && id == data.eventId + "_" + data.date
          && data.start is string && data.start.matches("^([01][0-9]|2[0-3]):[0-5][0-9]$")
          && data.end is string && data.end.matches("^([01][0-9]|2[0-3]):[0-5][0-9]$")
          && int(data.start.split(":")[0]) * 60 + int(data.start.split(":")[1])
            < int(data.end.split(":")[0]) * 60 + int(data.end.split(":")[1]) && counterStage(data.stage)
          && counterWall(data.opened) && counterWall(data.trialOpened) && counterWall(data.closing)
          && counterWall(data.ended) && counterWall(data.emptyConfirmed) && counterWall(data.finalized)
          && data.version is int && validCounterAudit(data);
      }

      function validStep(old, next, command) {
        let diff = next.diff(old).affectedKeys();
        let core = ["stage","version","operation","updatedAt","updatedByUid"];
        return (command == "trial" && old.stage == "prepare" && next.stage == "trial"
                && next.trialOpened != null && (old.trialOpened == null || next.trialOpened == old.trialOpened)
                && diff.hasOnly(core.concat(["trialOpened"])))
          || (command == "prepare" && old.stage == "trial" && next.stage == "prepare" && diff.hasOnly(core))
          || (command == "open" && old.stage in ["prepare","trial"] && next.stage == "open"
                && next.opened != null && diff.hasOnly(core.concat(["opened"])))
          || (command == "restrict" && old.stage == "open" && next.stage == "restricted" && diff.hasOnly(core))
          || (command == "unrestrict" && old.stage == "restricted" && next.stage == "open" && diff.hasOnly(core))
          || (command == "close" && old.stage in ["open","restricted"] && next.stage == "closing"
                && next.closing != null && next.closing >= old.opened && diff.hasOnly(core.concat(["closing"])))
          || (command == "reopen" && old.stage == "closing" && next.stage == "open"
                && next.closing == null && diff.hasOnly(core.concat(["closing"])))
          || (command == "finish" && old.stage == "closing" && next.stage == "finished"
                && next.ended != null && next.ended >= old.closing && next.emptyConfirmed == next.ended
                && next.finalized == null && diff.hasOnly(core.concat(["ended","emptyConfirmed"])))
          || (command == "verify" && old.stage == "finished" && old.finalized == null && next.stage == "finished"
                && next.finalized != null && next.finalized >= old.ended && diff.hasOnly(core.concat(["finalized"])))
          || (command == "unverify" && counterAdministrator() && old.stage == "finished" && old.finalized != null
                && next.stage == "finished" && next.finalized == null && diff.hasOnly(core.concat(["finalized"])));
      }

      function withCounterAction(next) {
        let path = /databases/$(database)/documents/counterDays/$(id)/actions/$(next.operation);
        let action = getAfter(path).data;
        return counterUuid(next.operation) && !exists(path)
          && action.from == resource.data.stage && action.to == next.stage && action.version == next.version
          && validCounterAudit(action) && validStep(resource.data,next,action.command);
      }

      allow get, list: if counterOperator();
      allow create: if counterOperator() && validDay(request.resource.data)
        && existsAfter(/databases/$(database)/documents/counterEvents/$(request.resource.data.eventId))
        && request.resource.data.stage == "prepare" && request.resource.data.version == 0
        && request.resource.data.operation == "" && request.resource.data.opened == null
        && request.resource.data.trialOpened == null && request.resource.data.closing == null
        && request.resource.data.ended == null && request.resource.data.emptyConfirmed == null
        && request.resource.data.finalized == null;
      allow update: if counterOperator() && validDay(request.resource.data)
        && ((resource.data.stage == "prepare"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["start","end","updatedAt","updatedByUid"]))
          || (request.resource.data.version == resource.data.version + 1 && withCounterAction(request.resource.data)
            && getAfter(/databases/$(database)/documents/events/$(id)/counterConfig/live).data.version == request.resource.data.version
            && getAfter(/databases/$(database)/documents/events/$(id)/counterConfig/test).data.version == request.resource.data.version));

      match /actions/{operation} {
        allow get, list: if counterOperator();
        allow create: if counterOperator() && counterUuid(operation)
          && request.resource.data.keys().hasOnly(["from","to","command","version","updatedAt","updatedByUid"])
          && validCounterAudit(request.resource.data)
          && getAfter(counterDayPath(id)).data.operation == operation
          && getAfter(counterDayPath(id)).data.version == get(counterDayPath(id)).data.version + 1;
      }
    }

    match /events/{eventId} {
      // The client query must include where("receptionTarget", "==", true).
      allow get, list: if approvedManagementTerminal()
        || (approvedReceptionTerminal() && resource.data.receptionTarget == true);
      allow create, update, delete: if approvedManagementTerminal();

      match /tickets/{ticketId} {
        // Only the currently active event can be downloaded by reception.
        allow read: if approvedManagementTerminal()
          || (approvedReceptionForEvent(eventId) && activeReceptionEvent(eventId));
        allow create, delete: if approvedManagementTerminal();
        // Reception changes are allowed only as an atomic ticket+record write.
        allow update: if approvedManagementTerminal()
          || validReceptionTicketUpdate(eventId, ticketId);
      }

      match /receptionRecords/{recordId} {
        allow list: if approvedManagementTerminal();
        allow get: if approvedManagementTerminal()
          || (approvedReceptionTerminal()
            && activeReceptionEvent(eventId)
            && (!exists(/databases/$(database)/documents/events/$(eventId)/receptionRecords/$(recordId))
              || resource.data.terminalId == receptionTerminalId()));
        allow create: if validReceptionRecordCreate(eventId, recordId);
        allow delete: if approvedManagementTerminal();
        allow update: if false;
      }

      match /receptionApprovals/{terminalId} {
        function validApproval(data) {
          return data.keys().hasAll(["eventId", "terminalId", "requestedByUid", "name", "status", "requestedAt"])
            && data.keys().hasOnly(["eventId", "terminalId", "requestedByUid", "name", "status", "requestedAt", "decidedAt", "decidedByUid"])
            && data.eventId == eventId && data.terminalId == terminalId
            && data.requestedByUid is string && data.requestedByUid.size() > 0 && data.requestedByUid.size() <= 128
            && data.name is string && data.name.size() > 0 && data.name.size() <= 80
            && data.requestedAt is string && data.requestedAt.size() <= 40
            && data.status in ["pending", "approved"];
        }
        allow get: if approvedManagementTerminal()
          || (approvedOwnInstallationForTerminal(terminalId) && terminalId == receptionTerminalId());
        allow list: if approvedManagementTerminal();
        allow create: if approvedReceptionTerminal() && activeReceptionEvent(eventId)
          && terminalId == receptionTerminalId() && validApproval(request.resource.data)
          && request.resource.data.requestedByUid == request.auth.uid && request.resource.data.status == "pending"
          && !request.resource.data.keys().hasAny(["decidedAt", "decidedByUid"]);
        allow update: if approvedManagementTerminal() && activeReceptionEvent(eventId)
          && (get(terminalPath(managementTerminalId())).data.admin == true
            || get(terminalPath(managementTerminalId())).data.subAdmin == true)
          && validApproval(request.resource.data) && resource.data.status == "pending"
          && request.resource.data.status == "approved"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "decidedAt", "decidedByUid"])
          && request.resource.data.decidedByUid == request.auth.uid
          && request.resource.data.decidedAt is string && request.resource.data.decidedAt.size() <= 40
          && exists(ownerPath(terminalId)) && get(ownerPath(terminalId)).data.enabled == true
          && get(installationPath(resource.data.requestedByUid)).data.approved == true
          && get(installationPath(resource.data.requestedByUid)).data.terminalId == terminalId;
        allow delete: if approvedManagementTerminal();
      }

      match /counterAssignments/{role} {
        allow get: if counterOperator();
        allow create, update: if counterOperator() && exists(counterDayPath(eventId)) && role in ["in","out"]
          && request.resource.data.keys().hasOnly(["uid","updatedAt","updatedByUid"])
          && validCounterAudit(request.resource.data)
          && (request.resource.data.uid == null
            ? (resource != null && resource.data.uid is string &&
              (getAfter(/databases/$(database)/documents/events/$(eventId)/counterDevices/$(resource.data.uid)).data.status != "approved"
                || getAfter(/databases/$(database)/documents/events/$(eventId)/counterDevices/$(resource.data.uid)).data.role != role))
            : (request.resource.data.uid is string && request.resource.data.uid.size() <= 160
              && (resource == null || resource.data.uid == null || resource.data.uid == request.resource.data.uid)
              && getAfter(/databases/$(database)/documents/events/$(eventId)/counterDevices/$(request.resource.data.uid)).data.status == "approved"
              && getAfter(/databases/$(database)/documents/events/$(eventId)/counterDevices/$(request.resource.data.uid)).data.role == role));
      }

      // Pairing reservations are addressed only by a six-digit code. Only the
      // issuing device or an operator with a recent lookup can read a reservation.
      match /counterPairAttempts/{uid} {
        allow create, update: if counterOperator() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["code","at"])
          && request.resource.data.code is string && request.resource.data.code.matches("^[0-9]{6}$")
          && request.resource.data.at == request.time
          && (resource == null || resource.data.at + duration.value(3,"s") <= request.time);
      }

      match /counterPairCodes/{code} {
        function attemptedCode(seconds) {
          let attempt = get(/databases/$(database)/documents/events/$(eventId)/counterPairAttempts/$(request.auth.uid)).data;
          return attempt.code == code && attempt.at + duration.value(seconds,"s") > request.time;
        }
        function validReservation(data) {
          let station = getAfter(counterDevicePath(eventId)).data;
          return code.matches("^[0-9]{6}$") && data.keys().hasOnly(["uid","device","issuedAt","usedAt"])
            && data.uid == request.auth.uid && data.device == station.device
            && data.issuedAt == request.time && data.usedAt == null
            && station.status == "pending" && station.pairingIssuedAt == request.time
            && (resource == null || resource.data.issuedAt + duration.value(5,"m") <= request.time);
        }
        function consumeReservation() {
          let station = getAfter(/databases/$(database)/documents/events/$(eventId)/counterDevices/$(resource.data.uid)).data;
          return counterOperator() && attemptedCode(300) && resource.data.usedAt == null
            && resource.data.issuedAt + duration.value(5,"m") > request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["usedAt"])
            && request.resource.data.usedAt == request.time
            && station.status == "approved" && station.pairingConfirmed == code
            && station.pairingIssuedAt == resource.data.issuedAt && station.device == resource.data.device;
        }
        allow get: if (signedIn() && resource != null && request.auth.uid == resource.data.uid)
          || (counterOperator() && attemptedCode(30)
            && (resource == null || (resource.data.usedAt == null
              && resource.data.issuedAt + duration.value(5,"m") > request.time)));
        allow create: if signedIn() && exists(counterDayPath(eventId)) && validReservation(request.resource.data);
        allow update: if (signedIn() && exists(counterDayPath(eventId)) && validReservation(request.resource.data))
          || consumeReservation();
      }

      match /counterCommands/{uid} {
        function currentStation() {
          return get(/databases/$(database)/documents/events/$(eventId)/counterDevices/$(uid)).data;
        }
        function commandMatchesStation(data) {
          let station = currentStation();
          return station.status == "approved" && station.device == data.device && station.role == data.role
            && station.updatedAt == data.assignment && station.mode == data.mode
            && get(counterAssignment(eventId,data.role)).data.uid == uid
            && get(/databases/$(database)/documents/events/$(eventId)/counterConfig/$(data.mode)).data.version == data.configVersion;
        }
        function validIssuedCommand(data) {
          return exists(counterDayPath(eventId)) && data.keys().hasOnly([
              "id","device","role","mode","configVersion","assignment","action","state","issuedAt","issuedBy"
            ]) && data.id is string && data.id.matches("^[a-f0-9-]{36}$")
            && data.role in ["in","out"] && counterMode(data.mode) && data.configVersion is int
            && data.action in ["diagnose","sync","stop","camera","engine","recalibrate"]
            && data.state == "issued" && data.issuedAt == request.time && data.issuedBy == request.auth.uid
            && commandMatchesStation(data);
        }
        function recordStarted(data) {
          return resource.data.state == "issued" && data.state == "running"
            && resource.data.issuedAt + duration.value(2,"m") > request.time
            && data.diff(resource.data).affectedKeys().hasOnly(["state","startedAt"])
            && data.startedAt == request.time && commandMatchesStation(resource.data);
        }
        function recordFinished(data) {
          return resource.data.state == "running" && data.state == "finished"
            && data.diff(resource.data).affectedKeys().hasOnly(["state","result","finishedAt","downtimeMs"])
            && data.result in ["ok","busy","local","interrupted","stale","failed"]
            && (!("downtimeMs" in data) || (data.action in ["camera","engine"] && data.result == "ok"
              && data.downtimeMs is int && data.downtimeMs >= 0 && data.downtimeMs <= 240000))
            && data.finishedAt == request.time;
        }
        function replaceCommand(data) {
          return data.id != resource.data.id &&
            (resource.data.state == "finished"
              || (resource.data.state == "issued" && resource.data.issuedAt + duration.value(2,"m") <= request.time)
              || (resource.data.state == "running" && resource.data.startedAt + duration.value(4,"m") <= request.time))
            && getAfter(/databases/$(database)/documents/events/$(eventId)/counterCommands/$(uid)/history/$(resource.data.id)).data == resource.data;
        }
        allow get: if counterOperator() || (signedIn() && request.auth.uid == uid && approvedCounterDevice(eventId));
        allow create: if counterOperator() && validIssuedCommand(request.resource.data);
        allow update: if (counterOperator() && validIssuedCommand(request.resource.data) && replaceCommand(request.resource.data))
          || (signedIn() && request.auth.uid == uid && approvedCounterDevice(eventId)
            && (recordStarted(request.resource.data) || recordFinished(request.resource.data)));
        match /history/{commandId} {
          allow get, list: if counterOperator();
          allow create: if counterOperator()
            && commandId == get(/databases/$(database)/documents/events/$(eventId)/counterCommands/$(uid)).data.id
            && request.resource.data == get(/databases/$(database)/documents/events/$(eventId)/counterCommands/$(uid)).data
            && getAfter(/databases/$(database)/documents/events/$(eventId)/counterCommands/$(uid)).data.id != commandId;
        }
      }

      match /counterDevices/{uid} {
        function ownCounterDevice() {
          return signedIn() && request.auth.uid == uid;
        }

        function validLuxnoraActivity(activity) {
          return activity == null || (activity is map && activity.keys().hasOnly(["reason","state","at"])
            && activity.reason in ["camera","inference","storage"]
            && activity.state in ["recovering","verified","failed"]
            && activity.at is int && counterTime(activity.at));
        }

        function validLuxnoraStatus(status) {
          return status == null || (status is map && status.keys().hasOnly(["fps","inferenceMs","activity"])
            && (status.fps == null || (status.fps is number && status.fps >= 0 && status.fps <= 240))
            && (status.inferenceMs == null || (status.inferenceMs is int && status.inferenceMs >= 0 && status.inferenceMs <= 60000))
            && validLuxnoraActivity(status.activity));
        }

        function validCounterHeartbeat(data) {
          return data.diff(resource.data).affectedKeys().hasOnly([
              "lastSeen", "version", "camera", "ai", "profile", "pending", "alert", "mode", "configVersion", "lux"
            ])
            && data.lastSeen == request.time && data.version is string && data.version.matches("^[0-9]{1,6}$")
            && data.camera is bool && data.ai is bool && counterMode(data.mode) && validLuxnoraStatus(data.get("lux",null))
            && (data.get("configVersion", null) == null || (data.configVersion is int && data.configVersion >= 0
              && data.configVersion <= get(/databases/$(database)/documents/events/$(eventId)/counterConfig/$(data.mode)).data.version))
            && data.profile in ["baseline", "detail", "lighting", "unknown"]
            && data.pending is int && data.pending >= 0 && data.pending <= 1000000
            && data.alert in ["none", "paused", "setup", "recalibrate", "camera", "storage", "network"];
        }

        function validCounterDeviceDecision(data) {
          return data.diff(resource.data).affectedKeys().hasOnly(["name", "role", "status", "updatedAt", "updatedByUid", "pairingConfirmed"])
            && validCounterDeviceName(data.name) && data.role in ["in", "out"]
            && data.status in ["pending", "approved", "rejected", "revoked"]
            && (data.role == resource.data.role || resource.data.status != "approved"
              || (resource.data.get("lastSeen", timestamp.date(1970, 1, 1)) > request.time - duration.value(3, "m")
                && resource.data.get("pending", -1) == 0 && resource.data.get("camera", true) == false))
            && data.updatedAt == request.time && data.updatedByUid == request.auth.uid;
        }

        function matchesPairing(data) {
          let code = data.get("pairingConfirmed", "");
          let pairing = getAfter(/databases/$(database)/documents/events/$(eventId)/counterPairCodes/$(code)).data;
          return code.matches("^[0-9]{6}$") && pairing.uid == uid && pairing.device == resource.data.device
            && pairing.usedAt == request.time && pairing.issuedAt == resource.data.pairingIssuedAt;
        }

        allow get: if ownCounterDevice() || counterOperator();
        allow list: if counterOperator();
        allow create: if ownCounterDevice() && counterScopeExists(eventId)
          && request.resource.data.keys().hasAll(["name", "device", "role", "status", "requestedAt"])
          && request.resource.data.keys().hasOnly(["name", "device", "role", "status", "requestedAt", "pairingIssuedAt"])
          && (exists(counterDayPath(eventId))
            ? request.resource.data.pairingIssuedAt == request.time : !("pairingIssuedAt" in request.resource.data))
          && validCounterDeviceName(request.resource.data.name) && validCounterDeviceId(request.resource.data.device)
          && request.resource.data.role in ["in", "out"] && request.resource.data.status == "pending"
          && request.resource.data.requestedAt == request.time;
        function assignmentMatches(data) {
          return (data.status != "approved" || getAfter(counterAssignment(eventId,data.role)).data.uid == uid)
            && (resource.data.status != "approved" || (data.status == "approved" && data.role == resource.data.role)
              || getAfter(counterAssignment(eventId,resource.data.role)).data.uid == null);
        }

        allow update: if (ownCounterDevice() && approvedCounterDevice(eventId) && validCounterHeartbeat(request.resource.data))
          || (ownCounterDevice() && exists(counterDayPath(eventId)) && resource.data.status in ["pending","rejected","revoked"] && request.resource.data.status == "pending"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pairingIssuedAt","pairingConfirmed","status"])
            && !("pairingConfirmed" in request.resource.data)
            && request.resource.data.pairingIssuedAt == request.time
            && resource.data.get("pairingIssuedAt", timestamp.date(1970,1,1)) + duration.value(30,"s") <= request.time)
          || (validCounterDeviceDecision(request.resource.data) &&
            ((!exists(counterDayPath(eventId)) && counterAdministrator())
              || (exists(counterDayPath(eventId)) && assignmentMatches(request.resource.data)
                && (counterAdministrator() || (counterOperator() && resource.data.status in ["pending","approved"]
                  && request.resource.data.status in ["pending","approved","rejected"]
                  && (resource.data.status != "approved" || request.resource.data.status == "approved"))))));

      }

      match /counterConfig/{mode} {
        allow get: if counterMode(mode) && (approvedCounterDevice(eventId) || counterOperator());
        function matchesCounterDay(data) {
          let day = getAfter(counterDayPath(eventId)).data;
          return validCounterAudit(day) && data.version == day.version
            && (mode == "live"
              ? data.opened == day.opened && data.closed == day.ended && data.verified == (day.finalized != null)
                && data.paused == !(day.stage in ["open","restricted","closing"])
              : data.opened == day.trialOpened && data.closed == null && data.verified == false
                && data.paused == (day.stage != "trial"));
        }
        allow create, update: if counterMode(mode) && validCounterConfig(request.resource.data)
          && ((existsAfter(counterDayPath(eventId)) && counterOperator() && matchesCounterDay(request.resource.data))
            || (!existsAfter(counterDayPath(eventId)) && exists(/databases/$(database)/documents/events/$(eventId))
              && (counterAdministrator() || (resource != null && counterOperator()
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["paused","updatedAt","updatedByUid"])))));

      }

      match /counterRuns/{mode}/operations/{operationId} {
        function validOperation(data) {
          return data is map
            && data.keys().hasAll(["id", "kind", "eventId", "mode", "device", "rawAt", "station"])
            && data.id == operationId && counterOperationId(data.id) && data.eventId == eventId && data.mode == mode
            && data.device is string && data.device.size() > 0 && data.device.size() <= 160
            && data.station in ["in", "out"] && counterTime(data.rawAt)
            && (!data.keys().hasAny(["createdAt"]) || counterTime(data.createdAt));
        }

        function autoCounterOperation(data) {
          return approvedCounterDevice(eventId)
            && data.kind == "passage" && validCounterPassage(data) && data.source == "auto" && data.person == "visitor"
            && data.device == get(counterDevicePath(eventId)).data.device
            && data.station == get(counterDevicePath(eventId)).data.role && data.direction == data.station
            && (!data.keys().hasAny(["actorUid"]) || data.actorUid == request.auth.uid);
        }

        function manualCounterOperation(data) {
          return counterOperator() && data.actorUid == request.auth.uid
            && (data.device == managementTerminalId() || data.device == request.auth.uid)
            && ((data.kind == "passage" && validCounterPassage(data) && data.source == "manual")
              || (data.kind == "revision" && validCounterRevision(data)));
        }

        function restoreCounterOperation(data) {
          let config = /databases/$(database)/documents/events/$(eventId)/counterConfig/$(mode);
          return counterAdministrator() && request.resource.data.restoredByUid == request.auth.uid
            && exists(config) && get(config).data.verified == false
            && (get(config).data.paused == true || (get(config).data.closed is number
              && get(config).data.closed <= request.time.toMillis()))
            && (!("actorUid" in data) || (data.actorUid is string && data.actorUid.matches("^[A-Za-z0-9_-]{1,160}$")))
            && ((data.kind == "passage" && validCounterPassage(data)
              && (data.source == "manual" || (data.person == "visitor" && data.direction == data.station)))
              || (data.kind == "revision" && validCounterRevision(data)));
        }
        allow get, list: if counterMode(mode) && (approvedCounterDevice(eventId) || counterOperator());
        allow create: if counterMode(mode) && counterScopeExists(eventId)
          && request.resource.data.receivedAt == request.time
          && validOperation(request.resource.data.payload)
          && ((request.resource.data.keys().hasOnly(["payload","receivedAt"])
            && (autoCounterOperation(request.resource.data.payload) || manualCounterOperation(request.resource.data.payload)))
            || (request.resource.data.keys().hasOnly(["payload","receivedAt","restoredByUid"])
              && restoreCounterOperation(request.resource.data.payload)));
      }

      match /analysis/{analysisId} {
        allow read: if approvedManagementTerminal();
        allow create, update, delete: if approvedManagementTerminal();
      }

      match /members/{memberId} {
        allow read: if approvedManagementTerminal();
        allow create, update, delete: if approvedManagementTerminal();
      }

      match /settings/{settingId} {
        allow read: if approvedManagementTerminal();
        allow create, update, delete: if approvedManagementTerminal();
      }
    }

    // Reception may fetch only the bundle whose token is still published by
    // its active event. This prevents a known, stale bundle token from exposing
    // old ticket lists after an event has been unpublished or replaced.
    function activeReceptionBundle(authToken) {
      return resource.data.authToken == authToken
        && resource.data.event.eventId is string
        && exists(/databases/$(database)/documents/events/$(resource.data.event.eventId))
        && get(/databases/$(database)/documents/events/$(resource.data.event.eventId)).data.authToken == authToken
        && get(/databases/$(database)/documents/events/$(resource.data.event.eventId)).data.receptionTarget == true
        && (
          !get(/databases/$(database)/documents/events/$(resource.data.event.eventId)).data.keys().hasAny(["eventStatus"])
          || get(/databases/$(database)/documents/events/$(resource.data.event.eventId)).data.eventStatus != "finished"
        );
    }

    // Management can inspect bundles; reception can get only the active bundle
    // explicitly selected by the server-published event metadata.
    match /eventBundles/{authToken} {
      allow get: if approvedManagementTerminal()
        || (approvedReceptionTerminal() && activeReceptionBundle(authToken));
      allow list: if approvedManagementTerminal();
      allow create, update, delete: if approvedManagementTerminal();
    }

    // Device/app settings can only be modified by approved management terminals.
    match /devices/{deviceId} {
      allow read: if approvedManagementTerminal();
      allow create, update, delete: if approvedManagementTerminal();
    }

    // Registration and management writes are client transactions guarded by these rules.
    match /terminals/{terminalId} {
      allow get: if approvedManagementTerminal() || approvedOwnInstallationForTerminal(terminalId)
        || (signedIn() && resource.data.requestedByUid == request.auth.uid && resource.data.approved == false)
        || (signedIn() && exists(applicationPath(terminalId))
          && get(applicationPath(terminalId)).data.requestedByUid == request.auth.uid
          && get(applicationPath(terminalId)).data.status == "pending");
      allow list: if approvedManagementTerminal();
      allow create: if validTerminalRegistrationCreate(terminalId);
      allow update: if validTerminalHeartbeatUpdate(terminalId)
        || (resource.data.approved == false && request.resource.data.approved == false
          && request.resource.data.status == "pending" && validOwnReceptionReapplication(terminalId))
        || (resource.data.approved == false && request.resource.data.approved == false
          && resource.data.status == "pending" && request.resource.data.status == "offline"
          && validOwnReceptionReapplicationCancellation(terminalId))
        || validOwnReceptionRelease(terminalId)
        || (approvedManagementTerminal()
          && (validManagedModeUpdate(terminalId)
            || validTerminalApprovalUpdate(terminalId)
            || validSubAdminUpdate(terminalId)
            || validManagedReceptionRevoke(terminalId)));
      allow delete: if (approvedManagementTerminal() && validTerminalDeletion(terminalId))
        || validOwnPendingTerminalCancellation(terminalId);
    }

    // Reception terminals may append validated error metadata only; they cannot
    // read, revise, or delete the log. Management retains read access.
    match /receptionErrors/{errorId} {
      allow list: if approvedManagementTerminal();
      allow get: if approvedManagementTerminal()
        || (approvedReceptionTerminal()
          && (!exists(/databases/$(database)/documents/receptionErrors/$(errorId))
            || resource.data.terminalId == receptionTerminalId()));
      allow create: if approvedReceptionTerminal()
        && request.resource.data.errorId == errorId
        && request.resource.data.eventId is string
        && request.resource.data.eventId.size() > 0
        && request.resource.data.eventId.size() <= 160
        && request.resource.data.terminalId == receptionTerminalId()
        && request.resource.data.category in [
          "unknown_ticket", "invalid_ticket", "invalid_state", "save_failed",
          "camera_failed", "event_load_failed", "sync_failed"
        ]
        && request.resource.data.mode in ["entry", "exit"]
        && validReceptionTimestamp(request.resource.data.timestamp)
        && request.resource.data.receivedAt == request.time
        && request.resource.data.keys().hasOnly([
          "errorId", "eventId", "terminalId", "category", "mode", "timestamp", "receivedAt"
        ]);
      allow update, delete: if false;
    }

    // Default-deny for every path not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
