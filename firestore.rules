rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // A browser UID is not a role. Management writes require a server-issued
    // installation grant and a currently approved management-capable terminal.
    function managementTerminalId() {
      return get(/databases/$(database)/documents/terminalInstallations/$(request.auth.uid)).data.terminalId;
    }

    function approvedManagementTerminal() {
      return signedIn()
        && exists(/databases/$(database)/documents/terminalInstallations/$(request.auth.uid))
        && get(/databases/$(database)/documents/terminalInstallations/$(request.auth.uid)).data.authUid == request.auth.uid
        && get(/databases/$(database)/documents/terminalInstallations/$(request.auth.uid)).data.approved == true
        && exists(/databases/$(database)/documents/terminalOwners/$(managementTerminalId()))
        && get(/databases/$(database)/documents/terminalOwners/$(managementTerminalId())).data.enabled == true
        && get(/databases/$(database)/documents/terminalOwners/$(managementTerminalId())).data.ownerUid == request.auth.uid
        && exists(/databases/$(database)/documents/terminals/$(managementTerminalId()))
        && get(/databases/$(database)/documents/terminals/$(managementTerminalId())).data.approved == true
        && get(/databases/$(database)/documents/terminals/$(managementTerminalId())).data.managementApproved == true
        && (
          get(/databases/$(database)/documents/terminals/$(managementTerminalId())).data.role == "management"
          || get(/databases/$(database)/documents/terminals/$(managementTerminalId())).data.role == "both"
        );
    }

    function approvedReceptionTerminal() {
      return signedIn()
        && exists(/databases/$(database)/documents/terminalInstallations/$(request.auth.uid))
        && get(/databases/$(database)/documents/terminalInstallations/$(request.auth.uid)).data.authUid == request.auth.uid
        && get(/databases/$(database)/documents/terminalInstallations/$(request.auth.uid)).data.approved == true
        && exists(/databases/$(database)/documents/terminalOwners/$(get(/databases/$(database)/documents/terminalInstallations/$(request.auth.uid)).data.terminalId))
        && get(/databases/$(database)/documents/terminalOwners/$(get(/databases/$(database)/documents/terminalInstallations/$(request.auth.uid)).data.terminalId)).data.enabled == true
        && exists(/databases/$(database)/documents/terminals/$(get(/databases/$(database)/documents/terminalInstallations/$(request.auth.uid)).data.terminalId))
        && get(/databases/$(database)/documents/terminals/$(get(/databases/$(database)/documents/terminalInstallations/$(request.auth.uid)).data.terminalId)).data.approved == true
        && (
          get(/databases/$(database)/documents/terminals/$(get(/databases/$(database)/documents/terminalInstallations/$(request.auth.uid)).data.terminalId)).data.receptionApproved == true
          || (
            !get(/databases/$(database)/documents/terminals/$(get(/databases/$(database)/documents/terminalInstallations/$(request.auth.uid)).data.terminalId)).data.keys().hasAny(["receptionApproved"])
            && get(/databases/$(database)/documents/terminals/$(get(/databases/$(database)/documents/terminalInstallations/$(request.auth.uid)).data.terminalId)).data.approved == true
          )
        )
        && (
          get(/databases/$(database)/documents/terminals/$(get(/databases/$(database)/documents/terminalInstallations/$(request.auth.uid)).data.terminalId)).data.role == "reception"
          || get(/databases/$(database)/documents/terminals/$(get(/databases/$(database)/documents/terminalInstallations/$(request.auth.uid)).data.terminalId)).data.role == "both"
        );
    }

    function receptionTerminalId() {
      return get(/databases/$(database)/documents/terminalInstallations/$(request.auth.uid)).data.terminalId;
    }

    function activeReceptionEvent(eventId) {
      return eventId is string
        && exists(/databases/$(database)/documents/events/$(eventId))
        && get(/databases/$(database)/documents/events/$(eventId)).data.receptionTarget == true
        && (
          !get(/databases/$(database)/documents/events/$(eventId)).data.keys().hasAny(["eventStatus"])
          || get(/databases/$(database)/documents/events/$(eventId)).data.eventStatus != "finished"
        );
    }

    function validReceptionTicketUpdate(eventId, ticketId) {
      let recordId = request.resource.data.lastReceptionRecordId;
      let beforeStatus = resource.data.currentStatus;
      let afterStatus = request.resource.data.currentStatus;
      return approvedReceptionTerminal()
        && activeReceptionEvent(eventId)
        && request.resource.data.eventId == eventId
        && request.resource.data.ticketId == ticketId
        && resource.data.ticketId == ticketId
        && resource.data.eventId == eventId
        && resource.data.valid == true
        && request.resource.data.valid == resource.data.valid
        && recordId is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "currentStatus", "updatedAt", "lastReceptionRecordId"
        ])
        && request.resource.data.updatedAt is string
        && existsAfter(/databases/$(database)/documents/events/$(eventId)/receptionRecords/$(recordId))
        && getAfter(/databases/$(database)/documents/events/$(eventId)/receptionRecords/$(recordId)).data.recordId == recordId
        && getAfter(/databases/$(database)/documents/events/$(eventId)/receptionRecords/$(recordId)).data.eventId == eventId
        && getAfter(/databases/$(database)/documents/events/$(eventId)/receptionRecords/$(recordId)).data.ticketId == ticketId
        && getAfter(/databases/$(database)/documents/events/$(eventId)/receptionRecords/$(recordId)).data.terminalId == receptionTerminalId()
        && getAfter(/databases/$(database)/documents/events/$(eventId)/receptionRecords/$(recordId)).data.timestamp == request.resource.data.updatedAt
        && (
          (beforeStatus == "unused" && afterStatus == "inside"
            && getAfter(/databases/$(database)/documents/events/$(eventId)/receptionRecords/$(recordId)).data.type == "entry")
          || (beforeStatus == "exited" && afterStatus == "inside"
            && getAfter(/databases/$(database)/documents/events/$(eventId)/receptionRecords/$(recordId)).data.type == "reentry")
          || (beforeStatus == "inside" && afterStatus == "exited"
            && getAfter(/databases/$(database)/documents/events/$(eventId)/receptionRecords/$(recordId)).data.type == "exit")
        );
    }

    function validReceptionRecordCreate(eventId, recordId) {
      let data = request.resource.data;
      let ticketPath = /databases/$(database)/documents/events/$(eventId)/tickets/$(data.ticketId);
      return approvedReceptionTerminal()
        && activeReceptionEvent(eventId)
        && data.keys().hasOnly(["recordId", "eventId", "ticketId", "terminalId", "type", "timestamp"])
        && data.recordId == recordId
        && data.eventId == eventId
        && data.ticketId is string
        && data.ticketId.size() > 0
        && data.ticketId.size() <= 160
        && data.terminalId == receptionTerminalId()
        && data.type in ["entry", "exit", "reentry"]
        && data.timestamp is string
        && exists(ticketPath)
        && get(ticketPath).data.valid == true
        && existsAfter(ticketPath)
        && getAfter(ticketPath).data.lastReceptionRecordId == recordId
        && getAfter(ticketPath).data.updatedAt == data.timestamp
        && (
          (data.type == "entry" && get(ticketPath).data.currentStatus == "unused"
            && getAfter(ticketPath).data.currentStatus == "inside")
          || (data.type == "reentry" && get(ticketPath).data.currentStatus == "exited"
            && getAfter(ticketPath).data.currentStatus == "inside")
          || (data.type == "exit" && get(ticketPath).data.currentStatus == "inside"
            && getAfter(ticketPath).data.currentStatus == "exited")
        );
    }

    // Client apps must never manage trusted ownership or server-issued handoff state.
    match /terminalOwners/{terminalId} {
      allow read, write: if false;
    }

    match /terminalInstallations/{uid} {
      allow read, write: if false;
    }

    match /terminalHandoffRequests/{requestId} {
      allow read, write: if false;
    }

    match /terminalHandoffRateLimits/{uid} {
      allow read, write: if false;
    }

    // Pending terminal applications are written only by callable Functions.
    // Clients must not forge applicant identity or approval state.
    match /terminalApplications/{terminalId} {
      allow read, write: if false;
    }

    // Event and ticket documents are restricted to approved management
    // installations. Reception reads published event bundles through the
    // dedicated eventBundles rule; reception ticket-state changes use callables.
    match /events/{eventId} {
      // Reception clients obtain only the single active event's metadata from a callable.
      allow get, list: if approvedManagementTerminal();
      allow create, update, delete: if approvedManagementTerminal();

      match /tickets/{ticketId} {
        allow read: if approvedManagementTerminal();
        allow create, delete: if approvedManagementTerminal();
        // Reception changes are allowed only as an atomic ticket+record write.
        allow update: if approvedManagementTerminal()
          || validReceptionTicketUpdate(eventId, ticketId);
      }

      match /receptionRecords/{recordId} {
        allow read: if approvedManagementTerminal();
        allow create: if validReceptionRecordCreate(eventId, recordId);
        allow update, delete: if false;
      }

      match /analysis/{analysisId} {
        allow read: if approvedManagementTerminal();
        allow create, update, delete: if approvedManagementTerminal();
      }

      match /members/{memberId} {
        allow read: if approvedManagementTerminal();
        allow create, update, delete: if approvedManagementTerminal();
      }

      match /settings/{settingId} {
        allow read: if approvedManagementTerminal();
        allow create, update, delete: if approvedManagementTerminal();
      }
    }

    // Reception may fetch only the bundle whose token is still published by
    // its active event. This prevents a known, stale bundle token from exposing
    // old ticket lists after an event has been unpublished or replaced.
    function activeReceptionBundle(authToken) {
      return resource.data.authToken == authToken
        && resource.data.event.eventId is string
        && exists(/databases/$(database)/documents/events/$(resource.data.event.eventId))
        && get(/databases/$(database)/documents/events/$(resource.data.event.eventId)).data.authToken == authToken
        && get(/databases/$(database)/documents/events/$(resource.data.event.eventId)).data.receptionTarget == true
        && (
          !get(/databases/$(database)/documents/events/$(resource.data.event.eventId)).data.keys().hasAny(["eventStatus"])
          || get(/databases/$(database)/documents/events/$(resource.data.event.eventId)).data.eventStatus != "finished"
        );
    }

    // Management can inspect bundles; reception can get only the active bundle
    // explicitly selected by the server-published event metadata.
    match /eventBundles/{authToken} {
      allow get: if approvedManagementTerminal()
        || (approvedReceptionTerminal() && activeReceptionBundle(authToken));
      allow list: if approvedManagementTerminal();
      allow create, update, delete: if approvedManagementTerminal();
    }

    // Device/app settings can only be modified by approved management terminals.
    match /devices/{deviceId} {
      allow read: if approvedManagementTerminal();
      allow create, update, delete: if approvedManagementTerminal();
    }

    // Terminal documents are read by clients, but every write is routed through
    // callable Functions so approval, ownership, heartbeat and role fields cannot
    // be forged by a signed-in browser.
    match /terminals/{terminalId} {
      // All terminal records are server-managed. Clients use callable status
      // endpoints rather than reading terminal identity/control documents directly.
      allow get, list: if approvedManagementTerminal();
      allow create, update, delete: if false;
    }

    // Reception terminals may append validated error metadata only; they cannot
    // read, revise, or delete the log. Management retains read access.
    match /receptionErrors/{errorId} {
      allow read: if approvedManagementTerminal();
      allow create: if approvedReceptionTerminal()
        && request.resource.data.errorId == errorId
        && request.resource.data.eventId is string
        && request.resource.data.eventId.size() > 0
        && request.resource.data.eventId.size() <= 160
        && request.resource.data.terminalId == receptionTerminalId()
        && request.resource.data.category in [
          "unknown_ticket", "invalid_ticket", "invalid_state", "save_failed",
          "camera_failed", "event_load_failed", "sync_failed"
        ]
        && request.resource.data.mode in ["entry", "exit"]
        && request.resource.data.timestamp is string
        && request.resource.data.keys().hasOnly([
          "errorId", "eventId", "terminalId", "category", "mode", "timestamp", "receivedAt"
        ]);
      allow update, delete: if false;
    }

    // Default-deny for every path not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
