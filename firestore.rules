rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Client apps must never manage trusted ownership or server-issued handoff state.
    match /terminalOwners/{terminalId} {
      allow read, write: if false;
    }

    match /terminalInstallations/{uid} {
      allow read, write: if false;
    }

    match /terminalHandoffRequests/{requestId} {
      allow read, write: if false;
    }

    match /terminalHandoffRateLimits/{uid} {
      allow read, write: if false;
    }

    // Event data is available only to authenticated Firebase clients.
    // Role-based management access requires a later server-verified admin claim.
    match /events/{eventId} {
      allow read, create, update, delete: if signedIn();

      match /tickets/{ticketId} {
        allow read, create, update, delete: if signedIn();
      }

      match /receptionRecords/{recordId} {
        allow read: if signedIn();
        // Writes are only allowed through the server-validated recordReception callable.
        allow create, update, delete: if false;
      }

      match /analysis/{analysisId} {
        allow read, create, update, delete: if signedIn();
      }

      match /members/{memberId} {
        allow read, create, update, delete: if signedIn();
      }

      match /settings/{settingId} {
        allow read, create, update, delete: if signedIn();
      }
    }

    // App settings are currently stored in devices/{deviceId}.
    // Authentication is required, but per-device ownership is not yet enforced.
    match /devices/{deviceId} {
      allow read, create, update, delete: if signedIn();
    }

    // Terminal documents are read by clients, but every write is routed through
    // callable Functions so approval, ownership, heartbeat and role fields cannot
    // be forged by a signed-in browser.
    match /terminals/{terminalId} {
      allow read, list: if signedIn();
      allow create, update, delete: if false;
    }

    // Default-deny for every path not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
