{
  "name": "qr-ticket-system",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "management-app",
    "reception-app",
    "shared"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspace management-app && npm run build --workspace reception-app",
    "test:rules": "firebase emulators:exec --only firestore \"node --test firestore.rules.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase-tools": "^14.0.0"
  }
}
